FROM python:3.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
WORKDIR /app
COPY requirements.lock ./requirements.lock
ARG INSTALL_CHROMIUM=true
RUN pip install --no-cache-dir -r requirements.lock playwright==1.62.0 \
    && apt-get update && apt-get install -y --no-install-recommends iptables util-linux && rm -rf /var/lib/apt/lists/* \
    && if [ "$INSTALL_CHROMIUM" = true ]; then python -m playwright install --with-deps chromium; fi \
    && useradd --uid 10003 --create-home observer \
    && mkdir -p /opt/browsers && chmod -R a+rX /opt/browsers
COPY app ./app
USER observer
EXPOSE 8010
CMD ["python", "-m", "uvicorn", "app.assistant_browser:app", "--host", "0.0.0.0", "--port", "8010", "--no-access-log"]
